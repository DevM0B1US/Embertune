{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Embertune",
  "version": "0.1.0",
  "identifier": "com.embertune.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Embertune",
        "width": 1100,
        "height": 720,
        "minWidth": 620,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["yt-dlp", "ffmpeg", "mpv", "nodejs"]
      }
    }
  }
}
