  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.17.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
